# =============================================================================
# Ronda — asistencia por QR rotativo
# Plantilla de variables de entorno.
#
# Este archivo SÍ se versiona: es la lista de variables que el proyecto
# necesita, sin valores reales. Copialo a .env.local y llená los valores ahí.
#
#     cp .env.example .env.local
#
# .env.local está en .gitignore y nunca se sube al repositorio.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos — Neon
# Proyecto: app_asistencia_actividades (hidden-art-98202594)
# Organización: DeveloperUMG (org-dawn-math-42337202)
#
# En la consola de Neon: Dashboard → Connect → copiar la cadena.
# -----------------------------------------------------------------------------

# Conexión con pooler. Es la que usa la aplicación en tiempo de ejecución.
# El host lleva "-pooler" en el nombre.
DATABASE_URL=

# Conexión directa, sin pooler. La usa Drizzle para correr migraciones.
# Mismo host pero SIN "-pooler".
DATABASE_URL_UNPOOLED=


# -----------------------------------------------------------------------------
# Autenticación — Neon Auth
#
# En la consola de Neon: Auth → Configuration.
# Copiá los nombres de variable EXACTAMENTE como los muestre la consola:
# si no coinciden con estos, mandan los de la consola.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=

# Clave de servidor. NUNCA va con prefijo NEXT_PUBLIC_ ni se expone al navegador.
STACK_SECRET_SERVER_KEY=


# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------

# URL base del sitio. Es la que se codifica dentro del QR, así que tiene que
# ser exacta o los códigos escaneados no resuelven.
#   local       → http://localhost:3000
#   producción  → https://asistencia-umg.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correos que arrancan con rol de administrador, separados por coma.
# Solo se aplica al crear la cuenta; después el rol vive en la base de datos.
ADMIN_EMAILS=
