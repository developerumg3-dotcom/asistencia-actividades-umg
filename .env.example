# =============================================================================
# Ronda — asistencia por QR rotativo
# Plantilla de variables de entorno.
#
# Este archivo SÍ se versiona: es la lista de variables que el proyecto
# necesita, sin valores reales. Copialo a .env.local y llená los valores ahí.
#
#     cp .env.example .env.local
#
# .env.local está en .gitignore y nunca se sube al repositorio.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de datos — Neon
# Proyecto: app_asistencia_actividades (hidden-art-98202594)
# Organización: DeveloperUMG (org-dawn-math-42337202)
#
# Consola de Neon → Dashboard → Connect
# -----------------------------------------------------------------------------

# Conexión con pooler. Es la que usa la aplicación en tiempo de ejecución.
# El host lleva "-pooler" en el nombre.
DATABASE_URL=

# Conexión directa, sin pooler. La usa Drizzle para correr migraciones.
# Mismo host pero SIN "-pooler". En la consola aparece como conexión directa.
# El nombre de esta variable es convención nuestra, no de Neon.
DATABASE_URL_UNPOOLED=


# -----------------------------------------------------------------------------
# Autenticación — Neon Auth (Managed Better Auth)
#
# Consola de Neon → Auth → Configuration
#
# Nota: Neon migró de Stack Auth a Managed Better Auth en enero de 2026.
# Si encontrás documentación que menciona NEXT_PUBLIC_STACK_PROJECT_ID,
# STACK_SECRET_SERVER_KEY o similares, está desactualizada.
# -----------------------------------------------------------------------------

# El "Auth URL" que muestra la consola.
# Ejemplo: https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# Secreto para firmar las cookies de sesión. Mínimo 32 caracteres.
# NO viene de la consola de Neon: se genera localmente con
#
#     openssl rand -base64 32
#
# Usá un valor distinto en desarrollo y en producción.
NEON_AUTH_COOKIE_SECRET=

# El "JWKS URL" que muestra la consola NO va acá: se deriva solo, es
# ${NEON_AUTH_BASE_URL}/.well-known/jwks.json


# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------

# URL base del sitio. Es la que se codifica dentro del QR, así que tiene que
# ser exacta o los códigos escaneados no resuelven.
#   local       → http://localhost:3000
#   producción  → https://app-asist-actividades-umg.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Correos que arrancan con rol de administrador, separados por coma.
# Solo se aplica al crear la cuenta; después el rol vive en la base de datos.
ADMIN_EMAILS=


# -----------------------------------------------------------------------------
# Notificaciones push — claves VAPID
#
# VAPID es cómo el servicio de push del navegador (Google, Apple, Mozilla)
# sabe que el aviso lo manda este sitio y no cualquiera. Es un par de claves
# que se genera UNA vez y no se vuelve a tocar:
#
#     npx web-push generate-vapid-keys
#
# Imprime las dos claves en base64url. Pegá cada una en su variable.
#
# Si se cambian, TODAS las suscripciones guardadas quedan inservibles y cada
# alumno tiene que volver a aceptar el permiso — que es algo que el navegador
# solo pregunta una vez en la vida. O sea: generalas una vez y guardalas.
#
# Ver docs/plan-notificaciones-push.md.
# -----------------------------------------------------------------------------

# Clave pública. El navegador la necesita para suscribirse, así que termina en
# el cliente igual — pero NO lleva prefijo NEXT_PUBLIC_: viaja como propiedad
# desde el servidor al componente que pide el permiso, que es el único lugar
# donde hace falta.
VAPID_PUBLIC_KEY=

# Clave privada. Firma cada envío. NUNCA sale del servidor, igual que el
# secreto_qr de las actividades: con ella cualquiera manda notificaciones en
# nombre de este sitio a los alumnos ya suscritos.
VAPID_PRIVATE_KEY=

# Contacto del responsable, por si el servicio de push necesita reportar un
# problema. Va como "mailto:correo" o como la URL del sitio.
# Ejemplo: mailto:admin@umg.edu.gt
VAPID_SUBJECT=
